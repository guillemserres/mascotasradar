---
import Icon from './Icon.astro';
import { SITE } from '../site.config';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

// Google exige (y la spec de schema.org recomienda) que "item" en un
// BreadcrumbList sea una URL absoluta, no una ruta relativa — con una
// ruta relativa el rich result de breadcrumbs puede no validarse.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, SITE.url).toString() } : {})
  }))
};
---

<nav class="breadcrumbs" aria-label="Migas de pan" data-pagefind-ignore>
  <ol>
    {
      items.map((item, i) => (
        <li>
          {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
          {i < items.length - 1 && (
            <span class="breadcrumbs__sep">
              <Icon name="chevronRight" size={13} />
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.82rem;
  }

  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .breadcrumbs a {
    color: var(--color-ink-faint);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-brand-dark);
    text-decoration: underline;
  }

  .breadcrumbs [aria-current='page'] {
    color: var(--color-ink-soft);
    font-weight: 500;
  }

  .breadcrumbs__sep {
    display: inline-flex;
    color: var(--color-border-strong);
  }
</style>

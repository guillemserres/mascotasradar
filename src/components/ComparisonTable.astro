---
import type { CollectionEntry } from 'astro:content';
import RatingStars from './RatingStars.astro';
import Icon from './Icon.astro';

interface Props {
  basePath: string;
  products: CollectionEntry<'productos'>[];
}

const { basePath, products } = Astro.props;
---

{
  products.length > 1 && (
    <div class="comparison" data-reveal>
      {
        // En móvil una tabla ancha obliga a deslizar en horizontal para ver
        // precio o "ideal para" — justo la info que más ayuda a decidir. Por
        // debajo de 700px se muestran tarjetas apiladas con todo visible sin
        // deslizar; de 700px en adelante hay sitio de sobra para la tabla
        // completa, así que se mantiene (más compacta de escanear con varios
        // productos).
      }
      <ul class="comparison__cards">
        {products.map((p, i) => (
          <li>
            <a
              class:list={['comparison__card', { 'comparison__card--top': i === 0 }]}
              href={`${basePath}${p.id}/`}
            >
              {p.data.imageUrl && (
                <img class="comparison__card-img" src={p.data.imageUrl} alt="" loading="lazy" decoding="async" />
              )}
              <div class="comparison__card-body">
                <p class="comparison__card-title">
                  {p.data.title}
                  {i === 0 && <span class="comparison__badge">Mejor valorado</span>}
                </p>
                <p class="comparison__rating">
                  <RatingStars rating={p.data.rating} size={13} />
                  {p.data.rating.toFixed(1)}
                </p>
                <p class="comparison__card-price">{p.data.price ?? 'Ver en Amazon'}</p>
                <p class="comparison__best-for">{p.data.bestFor}</p>
              </div>
              <Icon name="chevronRight" size={16} class="comparison__card-chevron" />
            </a>
          </li>
        ))}
      </ul>

      <div class="comparison__scroll">
        <table>
          <caption class="sr-only">
            Comparativa rápida de {products.length} productos en esta sección
          </caption>
          <thead>
            <tr>
              <th scope="col">Producto</th>
              <th scope="col">Valoración</th>
              <th scope="col">Precio orientativo</th>
              <th scope="col">Ideal para</th>
              <th scope="col">
                <span class="sr-only">Ver ficha</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {products.map((p, i) => (
              <tr class:list={{ 'comparison__top-row': i === 0 }}>
                <th scope="row">
                  <a href={`${basePath}${p.id}/`}>{p.data.title}</a>{' '}
                  {i === 0 && <span class="comparison__badge">Mejor valorado</span>}
                </th>
                <td>
                  <span class="comparison__rating">
                    <RatingStars rating={p.data.rating} size={13} />
                    {p.data.rating.toFixed(1)}
                  </span>
                </td>
                <td>{p.data.price ?? 'Ver en Amazon'}</td>
                <td class="comparison__best-for">{p.data.bestFor}</td>
                <td>
                  <a class="comparison__link" href={`${basePath}${p.id}/`}>
                    Ver ficha
                    <Icon name="chevronRight" size={13} />
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )
}

<style>
  .comparison {
    margin-top: var(--space-5);
  }

  .comparison__scroll {
    display: none;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .comparison__cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .comparison__card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .comparison__card:hover {
    border-color: var(--color-brand);
  }

  .comparison__card--top {
    border-color: var(--color-brand);
    background: var(--color-brand-tint);
  }

  .comparison__card-img {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    object-fit: contain;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: var(--space-1);
  }

  .comparison__card-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .comparison__card-title {
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.3;
  }

  .comparison__card-price {
    font-weight: 700;
    color: var(--color-brand-dark);
  }

  .comparison__card-chevron {
    flex: none;
    color: var(--color-ink-faint);
  }

  @media (min-width: 700px) {
    .comparison__scroll {
      display: block;
    }

    .comparison__cards {
      display: none;
    }
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    min-width: 560px;
  }

  th,
  td {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }

  thead th {
    font-family: var(--font-body);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-ink-faint);
    font-weight: 700;
    white-space: nowrap;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: none;
  }

  tbody th {
    font-family: var(--font-body);
    font-weight: 600;
    white-space: normal;
    min-width: 200px;
  }

  tbody th a {
    color: var(--color-ink);
    text-decoration: none;
  }

  tbody th a:hover {
    color: var(--color-brand-dark);
    text-decoration: underline;
  }

  .comparison__top-row {
    background: var(--color-brand-tint);
  }

  .comparison__badge {
    display: inline-block;
    margin-top: 4px;
    margin-left: 0.4rem;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
    background: var(--color-brand);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .comparison__best-for {
    white-space: normal;
    color: var(--color-ink-soft);
    max-width: 26ch;
  }

  .comparison__rating {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-weight: 700;
    color: var(--color-ink-soft);
  }

  .comparison__link {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: var(--color-brand-dark);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.82rem;
  }

  .comparison__link:hover {
    text-decoration: underline;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>

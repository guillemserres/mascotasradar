---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ProductLayout from '../../../../../layouts/ProductLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('productos', (entry) => entry.data.animal !== 'otras-mascotas');
  return entries.map((entry: CollectionEntry<'productos'>) => ({
    params: {
      animal: entry.data.animal,
      categoria: entry.data.categoria,
      tipo: entry.data.tipo,
      producto: entry.id
    },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ProductLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  animal={entry.data.animal}
  categoria={entry.data.categoria}
  tipo={entry.data.tipo}
  productSlug={entry.id}
  asinOrUrl={entry.data.asinOrUrl}
  price={entry.data.price}
  priceCheckedDate={entry.data.priceCheckedDate}
  rating={entry.data.rating}
  bestFor={entry.data.bestFor}
  pros={entry.data.pros}
  cons={entry.data.cons}
  imageUrl={entry.data.imageUrl}
  marca={entry.data.marca}
  variante={entry.data.variante}
>
  <Content />
</ProductLayout>

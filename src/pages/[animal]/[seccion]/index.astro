---
// Ruta legacy — solo otras-mascotas (conejos, roedores), que se quedó
// fuera del rediseño Categoría→Tipo a propósito. perros/gatos/acuarios
// usan la ruta nueva en [animal]/[categoria]/[tipo]/.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SectionHubLayout from '../../../layouts/SectionHubLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('guias', (entry) => entry.data.animal === 'otras-mascotas');
  return entries.map((entry: CollectionEntry<'guias'>) => ({
    params: { animal: entry.data.animal, seccion: entry.data.seccion },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<SectionHubLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  animal={entry.data.animal}
  seccion={entry.data.seccion}
>
  <Content />
</SectionHubLayout>
